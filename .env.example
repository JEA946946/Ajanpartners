# Kopiér til .env og udfyld. .env må aldrig i git.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.server
DJANGO_SECRET_KEY=skift-mig-til-en-lang-tilfaeldig-streng
DJANGO_ALLOWED_HOSTS=bogfoering.example.dk
CORS_ALLOWED_ORIGINS=https://bogfoering.example.dk
API_PORT=8001
GUNICORN_WORKERS=3

# --- Database (Postgres 16) -----------------------------------------------
DB_NAME=ajanpartners
DB_USER=postgres
DB_PASSWORD=skift-mig

# Første opstart: opret revisorhuset og den første partner (fjern bagefter)
BOOTSTRAP_DOMAIN=localhost
BOOTSTRAP_PARTNER_EMAIL=
BOOTSTRAP_PARTNER_PASSWORD=

# --- Integrationer (default: mock – virker uden aftaler) ------------------
# Generisk User-Agent til udgående kald (ingen personoplysninger)
INTEGRATIONS_USER_AGENT=bogforingssystem-integration/1.0
# CVR: mock | cvrapi | virk
CVR_PROVIDER=mock
CVRAPI_TOKEN=
CVR_VIRK_USER=
CVR_VIRK_PASSWORD=
# Valutakurser: mock | nationalbank
CURRENCY_PROVIDER=mock
# Open banking (PSD2/AIS): mock | aiia | tink | enablebanking
BANK_FEED_PROVIDER=mock
BANK_FEED_CLIENT_ID=
BANK_FEED_CLIENT_SECRET=
BANK_FEED_PRIVATE_KEY=
# Moms til Skattestyrelsen: mock | skat
SKAT_VAT_PROVIDER=mock
# E-faktura access point: mock | nemhandel | storecove | pagero
EINVOICE_ACCESS_POINT=mock
EINVOICE_DEFAULT_FORMAT=peppol
EINVOICE_API_KEY=
# SAF-T: 1.0 eller 2.1 (2.1 kræves af registrerede systemer fra 1.1.2027)
SAFT_VERSION=2.1
SAFT_STANDARD_ACCOUNT_VERSION=20260101

# --- Worker: planlagte job --------------------------------------------------
BANK_FEED_AT=06:00
BACKUP_AT=02:30
RESTORE_TEST_DAY=01

# --- Backup hos tredjepart i EU (S3-kompatibel) ----------------------------
BACKUP_ENCRYPTION=age
# Offentlig nøgle (age-keygen -y nøgle.txt). Den private nøgle opbevares offline.
BACKUP_AGE_RECIPIENT=age1...
# Kun til restore-test: sti til privat nøgle i containeren (./secrets er monteret på /run/secrets)
BACKUP_AGE_IDENTITY=/run/secrets/backup-age.key
BACKUP_GPG_RECIPIENT=
BACKUP_S3_BUCKET=bogforing-backup
BACKUP_S3_PREFIX=bogforing
# Endpoint for udbyder i EU, fx https://<region>.<udbyder>.example
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RETAIN_DAILY_DAYS=40
BACKUP_HEALTHCHECK_URL=
